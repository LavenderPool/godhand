  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.2.0",
    "@godhand/db": "workspace:*",
    "@godhand/mcp-godot": "workspace:*",
    "@godhand/shared": "workspace:*",
    "chokidar": "^4.0.3",
    "drizzle-orm": "^0.43.1",
    "dotenv": "^16.5.0",
    "execa": "^9.5.2",
    "fastify": "^5.3.3",
    "fs-extra": "^11.3.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.21",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
