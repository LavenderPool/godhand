{
  "name": "@godhand/mcp-godot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "godhand-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./lib": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "pnpm generate:tools && tsc && node scripts/copy-assets.js",
    "dev": "tsx watch src/index.ts",
    "generate:tools": "tsx scripts/generate-tool-manifest.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@godhand/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "execa": "^9.5.2",
    "fs-extra": "^11.3.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
